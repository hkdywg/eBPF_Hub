##
## .gitignore - eBPF Hub Project
##

###################################################
# Build Output
###################################################

# Build output directory
build_output/

# Compiled object files
*.o
*.obj

# Static libraries (generated during build)
*.a

# BPF skeleton headers (auto-generated by bpftool)
*.skel.h

# BPF object files
*.bpf.o

# Executables
*.out
*.exe

###################################################
# eBPF Specific
###################################################

# Generated vmlinux headers
vmlinux.h

# BTF files
*.btf

# Compiled BPF programs
*.bpf

###################################################
# IDE and Editor
###################################################

# VSCode
.vscode/
*.code-workspace

# Vim
*.swp
*.swo
*.viminfo
.*.swp

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# JetBrains IDEs (IntelliJ, CLion, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-workspace
*.sublime-project

###################################################
# Operating System
###################################################

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

###################################################
# Version Control
###################################################

# Git
*.orig
*.bak

###################################################
# Logs and Temporary Files
###################################################

# Log files
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Core dumps
core
core.*

###################################################
# Documentation Generated Files
###################################################

# HTML documentation (if generated)
docs/_build/
docs/.doctrees/

###################################################
# Dependency Lock Files (optional)
###################################################

# Keep these if you want to track dependency versions
# package-lock.json
# yarn.lock

###################################################
# Project Specific
###################################################

# Local configuration overrides
*.local
.env.local

# Test outputs
test_output/
coverage/

# Backup files
*.backup
*.old

###################################################
# Sisyphus (Project Management Tool)
###################################################

# Sisyphus plan files (optional - uncomment if needed)
# .sisyphus/

# Bash completion helper (generated, not needed in repo)
.bash_completion
